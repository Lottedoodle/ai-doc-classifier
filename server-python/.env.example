# =============================================================
#  AI Document Classifier — Environment Variables
#  Copy this file:  cp server-python/.env.example server-python/.env
#  แล้วเติมค่าจาก infra ที่สร้างเสร็จ
# =============================================================

# --- Server ---
# พอร์ตของ backend API (default 3001, frontend proxy ชี้มาที่พอร์ตนี้)
PORT=3001
# hot-reload ตอน dev (production ให้ตั้งเป็น 0)
RELOAD=1

# --- Supabase Auth (frontend login + API protection) ---
# URL และ anon/publishable key จาก Supabase Dashboard → Project Settings → API
# Frontend (Vite) อ่านจากตัวแปร VITE_* หรือ NEXT_PUBLIC_* ในไฟล์นี้
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# หรือใช้ชื่อแบบ Next.js ได้เช่นกัน:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Database: PostgreSQL (จำเป็นสำหรับ production) ---
# ใช้เก็บ metadata ของเอกสาร (ประเภท, ความมั่นใจ, เหตุผล ฯลฯ)
# ตารางถูกสร้างอัตโนมัติตอน server start (migrations 001, 002)
# ถ้าเว้นว่าง = fallback เก็บลงไฟล์ data.json (เหมาะกับ dev เท่านั้น)
# รูปแบบ: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=


# --- File Storage: S3 (ไฟล์เอกสารที่ upload เก็บที่นี่) ---
# ไฟล์จะอยู่ใต้ prefix "uploads/" ใน bucket
# ถ้าเว้นว่าง = fallback เก็บลง disk ที่ server-python/uploads (dev เท่านั้น)
S3_BUCKET=classify-docs-047750375159-ap-southeast-2-an
# region ของ bucket
AWS_REGION=ap-southeast-2

# --- AWS Credentials ---
# ถ้ารันบน EC2/ECS ที่มี IAM Role (แนะนำ) ไม่ต้องใส่ 2 ตัวนี้
# สิทธิ์ที่ role/user ต้องมี:
#   - S3      : s3:PutObject, s3:GetObject, s3:DeleteObject บน bucket ข้างบน
#   - Bedrock : bedrock:InvokeModel (สำหรับ AI classify)
# ถ้ารันนอก AWS (เช่น dev ในเครื่อง) ให้ใส่ access key ของ IAM user
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI Document Classification (ยิงผ่าน AWS Bedrock) ---
# ใช้จำแนกเอกสาร 4 ประเภท: purchase_order / invoice / receipt / general
# ถ้าเรียก AI ไม่ได้ = fallback เป็น keyword-based classifier อัตโนมัติ

# provider: "bedrock" (ยิงผ่าน AWS ใช้ IAM credentials, ไม่ต้องมี API key แยก)
#           หรือ "openai" (OpenAI-compatible API ภายนอก)
AI_PROVIDER=bedrock

# Bedrock model ID — ตัวที่ performance ใกล้ gpt-4o-mini และมี on-demand quota
# ใน ap-southeast-2 (Sydney):
#   amazon.nova-lite-v1:0                        (default — เร็ว ถูก multimodal, on-demand ใน Sydney)
#   anthropic.claude-3-haiku-20240307-v1:0       (on-demand ใน Sydney)
#   au.anthropic.claude-haiku-4-5-20251001-v1:0  (เก่งกว่า ผ่าน AU cross-region profile)
# หมายเหตุ: ต้องกด "Request model access" ใน Bedrock console ของ region นั้นก่อนใช้
AI_MODEL=amazon.nova-lite-v1:0

# region ของ Bedrock (ถ้าเว้นว่างจะใช้ AWS_REGION)
BEDROCK_REGION=ap-southeast-2

# --- ใช้เฉพาะกรณี AI_PROVIDER=openai ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# วินาทีที่รอผลจาก AI ก่อน fallback เป็น keyword (ไม่บังคับ)
AI_TIMEOUT=30

# --- Optional overrides (local dev ปกติไม่ต้องตั้ง) ---
# DATA_FILE=
# UPLOADS_DIR=
