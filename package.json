{
  "name": "ai-document-classifier",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "python server-python/run.py",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:check": "python server-python/db_check.py",
    "test:server": "python -m pytest server-python/tests -q"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3"
  }
}
